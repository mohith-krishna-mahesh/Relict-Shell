{
  "name": "relict-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"server,web\" -c \"cyan,magenta\" \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "pnpm run typecheck && vite build && pnpm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "generate:core-types": "openapi-typescript openapi/core.openapi.json -o src/lib/core-types.generated.ts",
    "prisma:generate": "prisma generate --schema server/src/db/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema server/src/db/schema.prisma",
    "species:import": "tsx scripts/import-species.ts",
    "species:tag": "tsx scripts/tag-species.ts",
    "postinstall": "pnpm run prisma:generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/themes": "^2.4.57",
    "@prisma/client": "^6.14.0",
    "cytoscape": "^3.33.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.2",
    "framer-motion": "^12.23.12",
    "helmet": "^8.1.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.1",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
